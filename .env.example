# ZOCO Tasks - variables de entorno
#
# Copiar a .env y completar. El archivo .env NO se versiona (ver .gitignore);
# este ejemplo si, para que quede documentado que necesita el sistema.
#
# El doble guion bajo es el separador de secciones de la configuracion de
# .NET: ConnectionStrings__ZocoDb equivale a ConnectionStrings:ZocoDb.

# --- Base de datos (PostgreSQL en Neon) --------------------------------------
# Copiar desde el panel de Neon > Connection Details, en formato .NET.
# SSL Mode=Require es obligatorio: Neon no acepta conexiones sin cifrar.
ConnectionStrings__ZocoDb=Host=<endpoint>.<region>.aws.neon.tech;Port=5432;Database=neondb;Username=<usuario>;Password=<password>;SSL Mode=Require;Trust Server Certificate=true

# --- Base de datos para los tests de integracion ------------------------------
# Apunta a un PostgreSQL local, no a Neon: los tests crean y destruyen esquemas
# en cada corrida, y hacerlo contra la nube seria lento y consumiria cuota.
ConnectionStrings__ZocoDbTests=Host=localhost;Port=5432;Database=zocotasks_tests;Username=postgres;Password=<password>

# --- Autenticacion ------------------------------------------------------------
# Clave de firma de los JWT. Minimo 32 caracteres.
# Generar una nueva por entorno, nunca reutilizar la de desarrollo.
Jwt__Clave=<cadena-aleatoria-de-al-menos-32-caracteres>
Jwt__Emisor=ZocoTasks
Jwt__Audiencia=ZocoTasks.Web
Jwt__MinutosDeVigencia=60

# --- Proveedor de IA para "Analizar oportunidad" ------------------------------
# Si no se define la API key, el endpoint responde de forma degradada en lugar
# de fallar: el resto del sistema sigue funcionando sin el proveedor.
Ia__Proveedor=Anthropic
Ia__ApiKey=<api-key>
Ia__Modelo=claude-sonnet-5
